# PLANTILLA. Este archivo SI se commitea, asi que aca no va ni un valor real.
# Copiar a `.env` (que esta en .gitignore) y llenar alli.

# Llave propia de la app. Viaja en el header X-API-Key y solo dice que quien
# llama es GeoMaps; no identifica al usuario.
APP_API_KEY=

# --- Airtable ------------------------------------------------------------
# PAT con alcance de escritura SOLO sobre la base de GeoMaps.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLA_USUARIOS=Usuarios
AIRTABLE_TABLA_DISPOSITIVOS=Dispositivos
AIRTABLE_TABLA_PROYECTOS=Proyectos
AIRTABLE_TABLA_MAPAS=Mapas
AIRTABLE_TABLA_TRAZADOS=Trazados
AIRTABLE_TABLA_WAYPOINTS=Waypoints
AIRTABLE_TABLA_ARCHIVOS=Archivos
AIRTABLE_TABLA_SINCRONIZACIONES=Sincronizaciones

# --- Identidad: correo con clave o Google --------------------------------
# Registro abierto por dos puertas. No hay proveedor de identidad de por medio:
# el backend verifica el ID token contra el JWKS de Google, o la clave contra un
# hash bcrypt, y guarda la persona en Airtable.
#
# La puerta de clave no necesita ninguna variable aca: el hash vive en Airtable
# y el resto son constantes en `app/services/auth.py`. Las tres de abajo son
# solo de Google, y sin ellas la app funciona igual con correo y clave.

# Client id de tipo **Web** del proyecto de Google Cloud. Es el que la app manda
# como `serverClientId` y el que aparece en el `aud` del token. Sin este,
# `google_sign_in` en Android entrega la sesion pero NO entrega idToken, y el
# backend se queda sin nada que verificar. No es secreto.
GOOGLE_CLIENT_ID_WEB=

# Client id de tipo Android. No viaja en el token, pero tiene que existir en
# Google Cloud con la huella SHA-1 de la firma del APK, o el login falla en el
# telefono con `ApiException: 10`, que no explica nada.
GOOGLE_CLIENT_ID_ANDROID=

# Secreto con el que se firman NUESTROS JWT. Nada que ver con Google. Rotarlo
# cierra todas las sesiones abiertas, que es lo que se quiere si se filtra.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Cuanto dura nuestro JWT. Largo a proposito: es lo que permite entrar con senal
# una vez y trabajar un mes en el monte sin volver a ver un login.
JWT_TTL_DIAS=30

# Techo de almacenamiento por cuenta. Con registro abierto, el limite tiene que
# existir antes que el primer abuso.
CUOTA_MB_POR_USUARIO=2048

# --- AWS S3 --------------------------------------------------------------
# MBTiles, geometrias GeoJSON, KML, GPX, PDF y fotos. Las credenciales solo
# viven en `.env`: una llave dentro de un APK que anda en el bolsillo de
# alguien es una llave publica. El telefono nunca ve estas cadenas, solo recibe
# URLs prefirmadas que le arma el backend.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region real, no "auto": eso era de Cloudflare R2. S3 firma con la region y
# una equivocada da SignatureDoesNotMatch, que no dice que el problema es la
# region. Bogota esta mas cerca de us-east-1.
AWS_REGION=us-east-1

# Bucket propio de GeoMaps. No reutilizar el de otro sistema: la estructura de
# este proyecto asume que borrar un proyecto es un delete por prefijo, y eso
# solo es seguro si nada mas vive en el bucket.
S3_BUCKET=

# Opcional. Si hay CloudFront delante, va aca. Sin el, todo sale por URL
# prefirmada, que es lo correcto para un bucket privado.
S3_CLOUDFRONT_URL=

# Cuanto vale una URL prefirmada, en segundos.
# Lectura larga porque bajar 400 MB de MBTiles sobre red rural tarda: si la URL
# vence a mitad, la descarga reanudable reintenta contra una URL muerta.
S3_TTL_LECTURA=86400
S3_TTL_ESCRITURA=3600
